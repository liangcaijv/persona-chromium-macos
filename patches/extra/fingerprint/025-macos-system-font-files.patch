+      }
+      [result removeObjectForKey:key];
+      NSMutableSet* names = names_by_file[file];
+      if (!names) {
+        names = [NSMutableSet set];
+        names_by_file[file] = names;
+      }
+      [names addObject:key];
+    }
+    for (NSURL* file in names_by_file) {
+      NSSet* names = names_by_file[file];
+      NSArray* from_file = CFToNSOwnershipCast(
+          CTFontManagerCreateFontDescriptorsFromURL(NSToCFPtrCast(file)));
+      for (id item in from_file) {
+        ScopedCFTypeRef<CFTypeRef> name_attribute(CTFontDescriptorCopyAttribute(
+            (__bridge CTFontDescriptorRef)item, kCTFontNameAttribute));
+        CFStringRef name =
+            base::apple::CFCast<CFStringRef>(name_attribute.get());
+        if (name && [names containsObject:CFToNSPtrCast(name)]) {
+          result[CFToNSPtrCast(name)] = item;
