+// persona-chromium: with a fingerprint persona, web content only sees the
+// fonts that ship with macOS in /System/Library/Fonts. Fonts macOS downloaded
+// for the host's languages (/System/Library/AssetsV2) or that were installed
+// separately behave as if they were not installed, both for font-family
+// lookups and for per-character fallback. --disable-spoofing=font turns this
+// off together with the other font spoofing.
+bool HideHostOnlyFonts() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  return command_line.HasSwitch(switches::kFingerprint) &&
+         command_line.GetSwitchValueASCII(switches::kDisableSpoofing)
+                 .find("font") == std::string::npos;
+}
+
+// True when `font` comes from a file outside /System/Library/Fonts. A font
+// without a file URL counts as a system font.
+bool IsHostOnlyFont(CTFontRef font) {
+  ScopedCFTypeRef<CFTypeRef> attribute(
+      CTFontCopyAttribute(font, kCTFontURLAttribute));
+  CFURLRef url = base::apple::CFCast<CFURLRef>(attribute.get());
+  if (!url) {
+    return false;
+  }
+  NSString* path = CFToNSPtrCast(url).path;
+  return path && ![path hasPrefix:@"/System/Library/Fonts/"];
+}
+
+// The first font of the persona language's cascade list for `base` that is
+// installed, is a system font and can draw `character`; null if none can.
+ScopedCFTypeRef<CTFontRef> SystemCascadeFont(CTFontRef base,
+                                             UChar32 character,
+                                             float size) {
+  // switches::kLang, read by name to keep ui/base out of this file.
+  const std::string lang =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("lang");
+  NSArray* languages =
+      lang.empty() ? nil : @[ base::SysUTF8ToNSString(lang) ];
+  NSArray* cascade =
+      CFToNSOwnershipCast(CTFontCopyDefaultCascadeListForLanguages(
+          base, NSToCFPtrCast(languages)));
+  for (id item in cascade) {
+    CTFontDescriptorRef descriptor = (__bridge CTFontDescriptorRef)item;
+    ScopedCFTypeRef<CFTypeRef> name_attribute(
+        CTFontDescriptorCopyAttribute(descriptor, kCTFontNameAttribute));
+    CFStringRef wanted =
+        base::apple::CFCast<CFStringRef>(name_attribute.get());
+    if (!wanted || CFStringHasPrefix(wanted, CFSTR("."))) {
+      continue;
+    }
+    ScopedCFTypeRef<CTFontRef> candidate(
+        CTFontCreateWithFontDescriptor(descriptor, size, nullptr));
+    if (!candidate || IsLastResortFont(candidate.get()) ||
+        IsHostOnlyFont(candidate.get())) {
+      continue;
+    }
+    // A cascade entry that is not installed comes back as another font.
+    ScopedCFTypeRef<CFStringRef> actual(
+        CTFontCopyPostScriptName(candidate.get()));
+    if (!actual ||
+        CFStringCompare(actual.get(), wanted, 0) != kCFCompareEqualTo) {
+      continue;
+    }
+    ScopedCFTypeRef<CFCharacterSetRef> characters(
+        CTFontCopyCharacterSet(candidate.get()));
+    if (characters &&
+        CFCharacterSetIsLongCharacterMember(characters.get(), character)) {
+      return candidate;
+    }
+  }
+  return ScopedCFTypeRef<CTFontRef>(nullptr);
+}
