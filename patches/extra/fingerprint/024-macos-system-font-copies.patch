+#if BUILDFLAG(IS_MAC)
+// persona-chromium: with a fingerprint persona (--fingerprint, unless
+// --disable-spoofing contains "font"), web content only sees the fonts that
+// ship with macOS (font_cache_mac.mm), so the per-script default font lists
+// skip families the host only has as downloads or separate installs, as on a
+// Mac without them. The switches are read by name to keep
+// components/ungoogled out of ui/gfx.
+bool HideHostOnlyFonts() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  return command_line.HasSwitch("fingerprint") &&
+         command_line.GetSwitchValueASCII("disable-spoofing").find("font") ==
+             std::string::npos;
+}
+
+// Families with an available font that ships with macOS: the same locations
+// as IsSystemFontPath() in font_cache_mac.mm, and a font without a file URL
+// counts as a system font there too.
+absl::flat_hash_set<std::string> SystemFontFamilies() {
+  absl::flat_hash_set<std::string> families;
+  base::apple::ScopedCFTypeRef<CTFontCollectionRef> collection(
+      CTFontCollectionCreateFromAvailableFonts(nullptr));
+  base::apple::ScopedCFTypeRef<CFArrayRef> descriptors(
+      CTFontCollectionCreateMatchingFontDescriptors(collection.get()));
+  if (!descriptors) {
+    return families;
+  }
+  for (CFIndex i = 0; i < CFArrayGetCount(descriptors.get()); ++i) {
+    CTFontDescriptorRef descriptor = base::apple::CFCast<CTFontDescriptorRef>(
+        CFArrayGetValueAtIndex(descriptors.get(), i));
+    if (!descriptor) {
+      continue;
+    }
+    base::apple::ScopedCFTypeRef<CFTypeRef> family_attribute(
+        CTFontDescriptorCopyAttribute(descriptor, kCTFontFamilyNameAttribute));
+    base::apple::ScopedCFTypeRef<CFTypeRef> url_attribute(
+        CTFontDescriptorCopyAttribute(descriptor, kCTFontURLAttribute));
+    CFStringRef family =
+        base::apple::CFCast<CFStringRef>(family_attribute.get());
+    CFURLRef url = base::apple::CFCast<CFURLRef>(url_attribute.get());
+    if (!family) {
+      continue;
+    }
+    if (url) {
+      base::apple::ScopedCFTypeRef<CFStringRef> path(
+          CFURLCopyFileSystemPath(url, kCFURLPOSIXPathStyle));
+      const std::string file = base::SysCFStringRefToUTF8(path.get());
+      if (!file.starts_with("/System/Library/Fonts/") &&
+          !file.starts_with(
+              "/System/Library/PrivateFrameworks/FontServices.framework/")) {
+        continue;
+      }
+    }
+    families.insert(base::SysCFStringRefToUTF8(family));
+  }
+  return families;
+}
+#endif
