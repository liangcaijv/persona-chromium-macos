+NSSize PersonaScreenSize() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  int width = 0;
+  int height = 0;
+  if (!command_line.HasSwitch("fingerprint") ||
+      command_line.GetSwitchValueASCII("disable-spoofing").find("screen") !=
+          std::string::npos ||
