+// The persona's available area in Cocoa coordinates when `screen` is the
+// persona's screen (the built-in display, or the first screen when there is
+// none): the persona screen shares the real screen's top-left corner and keeps
+// its menu bar and Dock insets. NSZeroRect otherwise.
+NSRect PersonaVisibleFrame(NSScreen* screen) {
+  const NSSize size = PersonaScreenSize();
+  if (size.width <= 0 || !screen) {
+    return NSZeroRect;
