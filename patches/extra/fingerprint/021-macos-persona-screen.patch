+// persona-chromium: with a fingerprint persona whose screen differs from the
+// host's built-in display, web content sees the persona's screen. The size
+// comes from --fingerprint-screen-width/height; --disable-spoofing=screen turns
+// it off.
+std::optional<gfx::Size> PersonaScreenSize() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  int width = 0;
+  int height = 0;
+  if (!command_line.HasSwitch(switches::kFingerprint) ||
+      command_line.GetSwitchValueASCII(switches::kDisableSpoofing)
+              .find("screen") != std::string::npos ||
+      !base::StringToInt(command_line.GetSwitchValueASCII(
+                             switches::kFingerprintScreenWidth),
+                         &width) ||
+      !base::StringToInt(command_line.GetSwitchValueASCII(
+                             switches::kFingerprintScreenHeight),
+                         &height) ||
+      width < 320 || width > 8192 || height < 320 || height > 8192) {
+    return std::nullopt;
+  }
+  return gfx::Size(width, height);
+}
+
+// Gives the persona's screen to the built-in display (the primary display when
+// there is none): same origin, the persona's size, and an available area that
+// keeps the real menu bar and Dock insets. Other displays are left alone, and
+// applying it twice gives the same result.
+void ApplyPersonaScreen(display::ScreenInfos& screen_infos) {
+  const std::optional<gfx::Size> size = PersonaScreenSize();
+  if (!size) {
+    return;
+  }
+  display::ScreenInfo* target = nullptr;
+  for (display::ScreenInfo& info : screen_infos.screen_infos) {
+    if (info.is_internal) {
+      target = &info;
+      break;
+    }
+  }
+  if (!target) {
+    for (display::ScreenInfo& info : screen_infos.screen_infos) {
+      if (info.is_primary) {
+        target = &info;
+        break;
+      }
+    }
+  }
+  if (!target) {
+    return;
+  }
+  const gfx::Rect rect = target->rect;
+  const gfx::Rect available = target->available_rect;
+  const int left = std::max(0, available.x() - rect.x());
+  const int top = std::max(0, available.y() - rect.y());
+  const int right = std::max(0, rect.right() - available.right());
+  const int bottom = std::max(0, rect.bottom() - available.bottom());
+  target->rect = gfx::Rect(rect.origin(), *size);
+  target->available_rect =
+      gfx::Rect(rect.x() + left, rect.y() + top,
+                std::max(0, size->width() - left - right),
+                std::max(0, size->height() - top - bottom));
 }
 
