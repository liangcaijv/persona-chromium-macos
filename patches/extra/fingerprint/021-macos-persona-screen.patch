+  NSScreen* target = nil;
+  for (NSScreen* candidate in [NSScreen screens]) {
+    NSNumber* number = candidate.deviceDescription[@"NSScreenNumber"];
+    if (number && CGDisplayIsBuiltin(number.unsignedIntValue)) {
+      target = candidate;
+      break;
+    }
+  }
+  if (!target) {
+    target = [NSScreen screens].firstObject;
+  }
+  if (![screen isEqual:target]) {
+    return NSZeroRect;
+  }
+  const NSRect frame = screen.frame;
+  const NSRect visible = screen.visibleFrame;
+  const CGFloat left = std::max<CGFloat>(0, NSMinX(visible) - NSMinX(frame));
+  const CGFloat right = std::max<CGFloat>(0, NSMaxX(frame) - NSMaxX(visible));
+  const CGFloat bottom = std::max<CGFloat>(0, NSMinY(visible) - NSMinY(frame));
+  const CGFloat top = std::max<CGFloat>(0, NSMaxY(frame) - NSMaxY(visible));
+  return NSMakeRect(NSMinX(frame) + left,
+                    NSMaxY(frame) - size.height + bottom,
+                    std::max<CGFloat>(0, size.width - left - right),
+                    std::max<CGFloat>(0, size.height - top - bottom));
+}
