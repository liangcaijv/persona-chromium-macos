+namespace {
+
+// A --lang value worth handing to Cocoa: 2-3 letters, optionally followed by
+// "-" and more letters, digits or "-" (for example "en-US").
+bool IsPlausibleLanguageTag(const std::string& tag) {
+  if (tag.size() < 2 || tag.size() > 35) {
+    return false;
+  }
+  size_t letters = 0;
+  while (letters < tag.size() && base::IsAsciiAlpha(tag[letters])) {
+    ++letters;
+  }
+  if (letters < 2 || letters > 3 ||
+      (letters < tag.size() && tag[letters] != '-')) {
+    return false;
+  }
+  for (char c : tag) {
+    if (!base::IsAsciiAlpha(c) && !base::IsAsciiDigit(c) && c != '-') {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+void SetUpCocoaLanguageFromCommandLine() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(switches::kProcessType) ||
+      !command_line.HasSwitch(switches::kLang)) {
+    return;
+  }
+  const std::string lang = command_line.GetSwitchValueASCII(switches::kLang);
+  if (!IsPlausibleLanguageTag(lang)) {
+    return;
+  }
+  @autoreleasepool {
+    NSString* language = base::SysUTF8ToNSString(lang);
+    NSString* locale = [language stringByReplacingOccurrencesOfString:@"-"
+                                                           withString:@"_"];
+    NSUserDefaults* defaults = NSUserDefaults.standardUserDefaults;
+    NSMutableDictionary* domain =
+        [[defaults volatileDomainForName:NSArgumentDomain] mutableCopy];
+    if (!domain) {
+      domain = [NSMutableDictionary dictionary];
+    }
+    domain[@"AppleLanguages"] = @[ language ];
+    domain[@"AppleLocale"] = locale;
+    [defaults setVolatileDomain:domain forName:NSArgumentDomain];
+  }
+}
+
 bool IsHelperAppLaunchedBySystemOrThirdPartyApplication() {
